\f0\fs24 \cf0 CREATE TABLE Room (\
    RNo VARCHAR(50) PRIMARY KEY,\
    Floor VARCHAR(50),\
    Department VARCHAR(100)\
);\
\
CREATE TABLE Staff (\
    SID VARCHAR(50) PRIMARY KEY,\
    Name VARCHAR(100) NOT NULL,\
    Position VARCHAR(100),\
    Phone VARCHAR(20)\
);\
\
CREATE TABLE Patient (\
    PID VARCHAR(50) PRIMARY KEY,\
    Name VARCHAR(100) NOT NULL,\
    Age INT,\
    Gender VARCHAR(20),\
    Phone VARCHAR(20),\
    Email VARCHAR(100)\
);\
\
CREATE TABLE Doctors (\
    DID VARCHAR(50) PRIMARY KEY,\
    Name VARCHAR(100) NOT NULL,\
    Specialization VARCHAR(100),\
    Phone VARCHAR(20),\
    SID VARCHAR(50),\
    RNo VARCHAR(50),\
    FOREIGN KEY (SID) REFERENCES Staff(SID),\
    FOREIGN KEY (RNo) REFERENCES Room(RNo)\
);\
\
CREATE TABLE Appointments (\
    AID VARCHAR(50) PRIMARY KEY,\
    Date DATE NOT NULL,\
    Time TIME NOT NULL,\
    Status VARCHAR(50),\
    PID VARCHAR(50),\
    DID VARCHAR(50),\
    SID VARCHAR(50),\
    FOREIGN KEY (PID) REFERENCES Patient(PID),\
    FOREIGN KEY (DID) REFERENCES Doctors(DID),\
    FOREIGN KEY (SID) REFERENCES Staff(SID)\
);\
\
CREATE TABLE Notification (\
    NID VARCHAR(50) PRIMARY KEY,\
    Type VARCHAR(50),\
    Status VARCHAR(50),\
    Date DATE,\
    Message TEXT,\
    PID VARCHAR(50),\
    AID VARCHAR(50),\
    FOREIGN KEY (PID) REFERENCES Patient(PID),\
    FOREIGN KEY (AID) REFERENCES Appointments(AID)\
);\
\
